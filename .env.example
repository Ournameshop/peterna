# =============================================================================
# Peterna — environment variables
# Copy to `.env.local` (gitignored) and fill in real values for local dev.
# Never commit a real .env file. See AGENTS.md.
# =============================================================================

# --- Database (Postgres 14+) -------------------------------------------------
# Local dev: `postgres://peterna:peterna@localhost:5432/peterna`
# Production host TBD (Neon / Supabase / RDS / self-hosted on EC2 fleet).
DATABASE_URL=

# --- AWS S3 (asset storage) --------------------------------------------------
# The bucket must be either (a) configured for public-read on the object keys we
# write, or (b) fronted by a CloudFront distribution — in which case
# S3_PUBLIC_BASE_URL points at the distribution domain, not the bucket URL.
# The SDK derives the endpoint from AWS_REGION; no custom endpoint is needed.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket name, e.g. peterna-tribute-assets
S3_BUCKET=
# Public-read base URL — either the S3 bucket URL
# (https://<bucket>.s3.<region>.amazonaws.com) or a CloudFront distribution
# domain (https://assets.peterna.com).
S3_PUBLIC_BASE_URL=

# --- AI vendors (Phase 1+) ---------------------------------------------------
# OpenAI: GPT Image 2 (image gen) + GPT-4o (vision pass primary)
OPENAI_API_KEY=
# Google Gemini 2.5 Pro: vision-pass fallback
GEMINI_API_KEY=
# fal.ai: image-gen fallback (Phase 2+) + sole Seedance video vendor (Phase 4+)
FAL_KEY=

# --- Session / cookies -------------------------------------------------------
# HMAC-SHA256 secret for signing the session cookie + resume tokens.
# Generate with: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
SESSION_SECRET=

# --- Phase 9 — Final Delivery ------------------------------------------------
# Origin used to build shareable tribute URLs of the form
# `<PUBLIC_BASE_URL>/tribute/<slug>`. Production should be
# `https://peterna.com`; local dev defaults to `http://localhost:3000` when
# this is unset (see `src/lib/delivery/slug.ts`).
PUBLIC_BASE_URL=

# Brevo transactional email API key — used by `/api/delivery/email` to send
# the "your tribute is ready" message. Generated under the Brevo dashboard
# "SMTP & API" → "API Keys" page. Leave empty in dev and the email route
# returns 503 `mailer-not-configured` instead of attempting to send.
BREVO_API_KEY=

# Verified sender on the Brevo account, e.g. `tributes@peterna.com`. Brevo
# rejects sends from unverified senders, so this must round-trip through
# their domain setup before going live.
DELIVERY_EMAIL_FROM=
# Optional friendly name shown next to the sender address. Defaults to
# "Peterna" when unset.
DELIVERY_EMAIL_FROM_NAME=

# --- Phase 12 — Web Push (VAPID) ---------------------------------------------
# Generate a fresh keypair with `npm run vapid:generate` and paste the
# printed values here. The public key is served to the browser at
# /api/push/vapid-public-key; the private key signs the JWT that
# authenticates push messages to FCM / autopush / mozilla services.
#
# Rotating these invalidates every existing push subscription — only do
# it intentionally.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Per the VAPID spec, a mailto: URL or your origin (https://...). Used by
# push services to contact you if your sender is misbehaving.
VAPID_SUBJECT=mailto:admin@peterna.com

# --- Phase 14 — Admin dashboard ----------------------------------------------
# Comma-separated emails authorized for /admin (case-insensitive). Membership
# gates every /api/admin/* route. Leave empty in dev to close the gate entirely.
ADMIN_EMAILS=

# --- Dev escape hatches ------------------------------------------------------
# Set to "1" to allow the library skeleton to load while content stubs are still empty
# (Phase 0 scaffolding). Remove once formats/themes/art-styles/pronouns are populated.
SKIP_LIBRARY_VALIDATION=
