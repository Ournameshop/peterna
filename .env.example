# =============================================================================
# Peterna — environment variables
# Copy to `.env.local` (gitignored) and fill in real values for local dev.
# Never commit a real .env file. See AGENTS.md.
# =============================================================================

# --- Database (Postgres 14+) -------------------------------------------------
# Local dev: `postgres://peterna:peterna@localhost:5432/peterna`
# Production host TBD (Neon / Supabase / RDS / self-hosted on EC2 fleet).
DATABASE_URL=

# --- AWS S3 (asset storage) --------------------------------------------------
# The bucket must be either (a) configured for public-read on the object keys we
# write, or (b) fronted by a CloudFront distribution — in which case
# S3_PUBLIC_BASE_URL points at the distribution domain, not the bucket URL.
# The SDK derives the endpoint from AWS_REGION; no custom endpoint is needed.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket name, e.g. peterna-tribute-assets
S3_BUCKET=
# Public-read base URL — either the S3 bucket URL
# (https://<bucket>.s3.<region>.amazonaws.com) or a CloudFront distribution
# domain (https://assets.peterna.com).
S3_PUBLIC_BASE_URL=

# --- AI vendors (Phase 1+) ---------------------------------------------------
# OpenAI: GPT Image 2 (image gen) + GPT-4o (vision pass primary)
OPENAI_API_KEY=
# Google Gemini 2.5 Pro: vision-pass fallback
GEMINI_API_KEY=
# fal.ai: image-gen fallback (Phase 2+) + sole Seedance video vendor (Phase 4+)
FAL_KEY=

# --- Session / cookies -------------------------------------------------------
# HMAC-SHA256 secret for signing the session cookie + resume tokens.
# Generate with: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
SESSION_SECRET=

# --- Dev escape hatches ------------------------------------------------------
# Set to "1" to allow the library skeleton to load while content stubs are still empty
# (Phase 0 scaffolding). Remove once formats/themes/art-styles/pronouns are populated.
SKIP_LIBRARY_VALIDATION=
