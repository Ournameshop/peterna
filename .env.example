# =============================================================================
# Peterna — environment variables
# Copy to `.env.local` (gitignored) and fill in real values for local dev.
# Never commit a real .env file.
#
# LEGEND:
#   [required]  must be set or the app errors at boot / first call.
#   [recommended] not strictly required, but you'll hit a wall mid-flow.
#   [optional]  for niche dev / debugging.
#
# MINIMUM-VIABLE BOOT (just to get the dev server running + intake working):
#   DATABASE_URL, SESSION_SECRET, PUBLIC_BASE_URL,
#   AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
#   S3_BUCKET, S3_PUBLIC_BASE_URL, OPENAI_API_KEY.
#
# FOR A FULL END-TO-END TEST (all 12 stages + delivery + push + admin):
#   add GEMINI_API_KEY, FAL_KEY, BREVO_API_KEY, DELIVERY_EMAIL_FROM,
#   VAPID_* (run `npm run vapid:generate`), ADMIN_EMAILS.
# =============================================================================


# --- Database (Postgres 14+) ----------------------------------------- [required]
# Local dev: `postgres://peterna:peterna@localhost:5432/peterna`
# Bootstrap:
#   brew services start postgresql@16
#   createdb peterna
#   npm run db:migrate   # applies 0000–0008
DATABASE_URL=postgres://peterna:peterna@localhost:5432/peterna


# --- Session secret -------------------------------------------------- [required]
# HMAC-SHA256 key for the session + resume + user-auth cookies.
# Generate fresh:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=


# --- Public base URL ------------------------------------------------- [required]
# Origin used to build shareable tribute URLs (`/tribute/<slug>`), magic-link
# callback URLs, etc. In dev keep this as localhost; in prod it's
# https://peterna.com (or your staging hostname).
PUBLIC_BASE_URL=http://localhost:3000


# --- AWS S3 (asset storage) ------------------------------------------ [required]
# Where uploaded photos + every vendor-rendered asset (character sheet,
# storyboard frames, video clips, eulogy PDF) are durably stored.
#
# Option A (simplest for dev): public-read bucket policy on the object keys
# we write. S3_PUBLIC_BASE_URL = `https://<bucket>.s3.<region>.amazonaws.com`
#
# Option B (recommended for prod): bucket is private, fronted by a CloudFront
# distribution. S3_PUBLIC_BASE_URL = the distribution domain (e.g.
# https://assets.peterna.com).
#
# Console: https://console.aws.amazon.com/s3/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=peterna-tribute-assets-dev
S3_PUBLIC_BASE_URL=


# --- OpenAI (image gen + vision pass primary) ------------------------ [required]
# Used by: GPT Image 2 (gpt-image-2-2026-04-21) for every render —
# character sheet, combination preview, storyboard frames, card preview.
# Also GPT-4o (gpt-4o-2024-11-20) for the Stage 1.4 vision pass + Stage 4
# beat-sheet generation + Stage 5.7 per-frame vision pass.
#
# Get one at: https://platform.openai.com/api-keys
# Needs: project must have access to gpt-image-2 + gpt-4o.
OPENAI_API_KEY=


# --- Google Gemini (vision pass fallback) ------------------------ [recommended]
# Gemini 2.5 Pro used as the vision-pass + beat-sheet fallback when OpenAI
# 429s / 5xxs. Free tier is plenty for dev (15 req/min).
#
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# --- fal.ai (image fallback + sole Seedance video vendor) ---------- [required]
# Used by:
#   - generateImage() fallback when OpenAI fails.
#   - Stage 6 video rendering (ByteDance Seedance 2.0 via
#     bytedance/seedance-2.0/image-to-video) — fal is the SOLE vendor for
#     video, no direct ByteDance API is available from the US.
#
# Without this the flow halts at Stage 6.
#
# Get one at: https://fal.ai/dashboard/keys
FAL_KEY=


# --- Brevo (transactional email — Phase 9 delivery + Phase 10 magic-link) -- [recommended]
# Sends two kinds of mail:
#   1. "Your tribute is ready" share-link email (Phase 9 delivery + Phase 12
#      notify_ready job).
#   2. Sign-in magic-link emails (Phase 10).
#
# Without this, anonymous flows still work but: users can't request a
# share-link email, can't sign in via magic-link (so no dashboard), and won't
# receive a heads-up when their long video render completes.
#
# Get one at: https://app.brevo.com/settings/keys/api (Brevo dashboard →
# "SMTP & API" → "API Keys"). Free tier = 300 emails/day.
BREVO_API_KEY=

# Verified sender on the Brevo account. Brevo rejects sends from unverified
# senders — go through their domain setup before pointing this at peterna.com.
# For dev with a verified personal email, just use that.
DELIVERY_EMAIL_FROM=

# Optional friendly name shown next to the sender address. Defaults to "Peterna".
DELIVERY_EMAIL_FROM_NAME=


# --- Web Push (VAPID — Phase 12) --------------------------------- [recommended]
# Browser notifications when a long video render completes. Without these,
# the opt-in UI gracefully degrades to "we'll email you instead."
#
# Generate a fresh keypair (one-time):
#   npm run vapid:generate
# Paste the printed values here. Rotating invalidates every existing push
# subscription — only do it intentionally.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# VAPID spec requires a mailto: URL or your origin (https://...). Used by
# push services (FCM / Mozilla autopush) to contact you if a sender misbehaves.
VAPID_SUBJECT=mailto:xeeshan.ah@gmail.com


# --- Admin dashboard (Phase 14) ---------------------------------- [recommended]
# Comma-separated emails authorized for /admin (case-insensitive). Membership
# gates every /api/admin/* route. To use it locally: sign in with one of
# these emails via the magic-link flow, then browse to /admin.
#
# Leave empty in dev to close the gate entirely.
ADMIN_EMAILS=xeeshan.ah@gmail.com


# --- Dev escape hatches --------------------------------------------- [optional]

# Force a specific AI vendor for debugging the hybrid layer. Accepts:
#   `openai` — skip fal fallback for images
#   `fal`    — skip OpenAI primary for images (test the fallback path)
#   `gemini` — skip OpenAI primary for vision
# Leave empty for normal direct-primary + fal/gemini-fallback behavior.
AI_VENDOR_OVERRIDE=

# Set to "1" to let the library skeleton load while content stubs are empty.
# Should be empty in normal operation now that all libraries are populated.
SKIP_LIBRARY_VALIDATION=
